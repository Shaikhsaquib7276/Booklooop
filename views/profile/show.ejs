<% layout("layouts/boilerplate") %>

<div class="container py-5">

  <div class="text-center">

    <img src="<%= seller.profileImage.url %>" class="rounded-circle" width="150">

    <h2 class="mt-3">

      <%= seller.username %>

    </h2>

    <p>

      📍 <%= seller.city || "City not added" %>

    </p>

    <p>

      🏫 <%= seller.college || "College not added" %>

    </p>

    <p>

      📞 <%= seller.phone || "Phone not added" %>

    </p>

  </div>

  <hr>

  <h3>

    Books Listed

  </h3>

  <div class="row">

    <% books.forEach(book=>{ %>

    <div class="col-md-4 mb-4">

      <div class="card h-100">

        <img src="<%= book.image.url %>" class="card-img-top" style="height:220px;object-fit:cover;">

        <div class="card-body">

          <h5>

            <%= book.title %>

          </h5>

          <p>

            ₹<%= book.price %>

          </p>

          <a href="/books/<%= book._id %>" class="btn btn-primary">

            View Book

          </a>

        </div>

      </div>

    </div>

    <% }) %>

  </div>

</div>