<% layout("/layouts/boilerplate") %>
<div class="admin-page">
  <div class="admin-hero"><div><span class="admin-eyebrow">BookLoop administration</span><h1>Admin Dashboard</h1><p>Monitor marketplace activity and manage the platform.</p></div><i class="bi bi-shield-lock"></i></div>
  <div class="row g-3 mt-3">
    <div class="col-6 col-lg-3"><div class="admin-stat"><i class="bi bi-book"></i><strong><%= stats.bookCount %></strong><span>Books</span></div></div>
    <div class="col-6 col-lg-3"><div class="admin-stat"><i class="bi bi-people"></i><strong><%= stats.userCount %></strong><span>Users</span></div></div>
    <div class="col-6 col-lg-3"><div class="admin-stat"><i class="bi bi-receipt"></i><strong><%= stats.orderCount %></strong><span>Orders</span></div></div>
    <div class="col-6 col-lg-3"><div class="admin-stat"><i class="bi bi-currency-rupee"></i><strong>₹<%= stats.revenue.toFixed(2) %></strong><span>Paid Revenue</span></div></div>
  </div>
  <div class="admin-actions mt-4">
    <a href="/admin/books" class="btn btn-primary"><i class="bi bi-book me-2"></i>Manage Books</a>
    <a href="/admin/users" class="btn btn-outline-primary"><i class="bi bi-people me-2"></i>Manage Users</a>
    <a href="/admin/orders" class="btn btn-outline-primary"><i class="bi bi-receipt me-2"></i>View Orders</a>
  </div>
</div>
