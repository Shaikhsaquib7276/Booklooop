<% layout("/layouts/boilerplate") %><div class="admin-page"><section class="admin-section"><div class="admin-section-head"><div><span class="admin-eyebrow">Academic Match</span><h2>Academic Catalog</h2><p class="text-secondary">Add syllabus book mappings. Only records entered here appear in the student finder.</p></div><a href="/admin" class="btn btn-outline-primary btn-sm">Dashboard</a></div>
<div class="academic-admin-card mb-4"><h4>Add a book mapping</h4><form method="POST" action="/admin/academic"><div class="row g-3">
<div class="col-md-6 col-lg-4"><label class="form-label">College</label><input class="form-control" name="college"  required></div><div class="col-md-6 col-lg-4"><label class="form-label">Course</label><input class="form-control" name="course"  required></div><div class="col-md-6 col-lg-4"><label class="form-label">Academic year</label><input class="form-control" name="academicYear"  required></div><div class="col-md-6 col-lg-4"><label class="form-label">Semester</label><input class="form-control" name="semester" type="number" min="1" required></div><div class="col-md-6 col-lg-4"><label class="form-label">Subject</label><input class="form-control" name="subject"  required></div><div class="col-md-6 col-lg-4"><label class="form-label">Subject code</label><input class="form-control" name="subjectCode"  ></div><div class="col-md-6 col-lg-4"><label class="form-label">Book title</label><input class="form-control" name="title"  required></div><div class="col-md-6 col-lg-4"><label class="form-label">Author</label><input class="form-control" name="author"  ></div><div class="col-md-6 col-lg-4"><label class="form-label">ISBN</label><input class="form-control" name="isbn"  ></div><div class="col-md-6 col-lg-4"><label class="form-label">Edition</label><input class="form-control" name="edition"  ></div>
<div class="col-md-4"><label class="form-label">Type</label><select class="form-select" name="type"><option>Prescribed</option><option>Reference</option></select></div></div><button class="btn btn-primary mt-3">Add to catalog</button></form></div>
<div class="academic-admin-card"><h4>Catalog records (<%= academicBooks.length %>)</h4><div class="table-responsive"><table class="table align-middle"><thead><tr><th>College / course</th><th>Year / semester</th><th>Subject</th><th>Book</th><th></th></tr></thead><tbody><% academicBooks.forEach(b=>{ %><tr><td><%= b.college %><br><small><%= b.course %></small></td><td><%= b.academicYear %> / <%= b.semester %></td><td><%= b.subject %></td><td><%= b.title %><br><small><%= b.isbn||"" %></small></td><td><form method="POST" action="/admin/academic/<%= b._id %>?_method=DELETE"><button class="btn btn-sm btn-outline-danger">Archive</button></form></td></tr><% }) %></tbody></table></div></div></section></div>