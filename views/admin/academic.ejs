<% layout("/layouts/boilerplate") %><div class="admin-page"><section class="admin-section"><div class="admin-section-head"><div><h2>Academic Catalog</h2><p>Add the prescribed and reference books for each course and semester.</p></div><a href="/admin" class="btn btn-outline-primary btn-sm">Dashboard</a></div><div class="academic-admin-card mb-4"><h4>Add academic book</h4><form method="POST" action="/admin/academic"><div class="row g-3"><% [["college","College"],["course","Course"],["academicYear","Academic year"],["semester","Semester"],["subject","Subject"],["subjectCode","Subject code"],["title","Book title"],["author","Author"],["isbn","ISBN"],["edition","Edition"]].forEach(([n,l])=>{ %><div class="col-md-6 col-lg-4"><label class="form-label"><%= l %></label><input class="form-control" name="<%= n %>" <%= ["college","course","academicYear","semester","subject","title"].includes(n)?"required":"" %> <%= n==="semester"?'type=number min=1':"" %>></div><% }) %><div class="col-md-4"><label class="form-label">Type</label><select class="form-select" name="type"><option>Prescribed</option><option>Reference</option></select></div></div><button class="btn btn-primary mt-3">Add to catalog</button></form></div><div class="academic-admin-card"><h4>Catalog records (<%= academicBooks.length %>)</h4><div class="table-responsive"><table class="table"><thead><tr><th>College/course</th><th>Year/sem</th><th>Subject</th><th>Book</th><th></th></tr></thead><tbody><% academicBooks.forEach(b=>{ %><tr><td><%= b.college %><br><%= b.course %></td><td><%= b.academicYear %> / <%= b.semester %></td><td><%= b.subject %></td><td><%= b.title %></td><td><form method="POST" action="/admin/academic/<%= b._id %>?_method=DELETE"><button class="btn btn-sm btn-outline-danger">Archive</button></form></td></tr><% }) %></tbody></table></div></div></section></div>