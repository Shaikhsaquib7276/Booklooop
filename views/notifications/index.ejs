<% layout("/layouts/boilerplate") %><div class="academic-page"><div class="academic-results-heading"><div><h1>Notifications</h1><p>Book matches and updates about your requests.</p></div></div><% if(!notifications.length){ %><div class="academic-empty"><h3>No notifications yet</h3><p>We'll show updates here when a requested book becomes available.</p></div><% }else{ %><div class="notification-list"><% notifications.forEach(n=>{ %><a class="notification-card" href="<%= n.link||'/' %>"><strong><%= n.title %></strong><p><%= n.message %></p><small><%= new Date(n.createdAt).toLocaleString() %></small></a><% }) %></div><% } %></div>