<% layout("/layouts/boilerplate") %><div class="academic-page"><h1>Notifications</h1><p>Book matches and updates about your requests.</p><% if(!notifications.length){ %><div class="academic-empty"><h3>No notifications yet</h3></div><% }else{ %><div class="notification-list"><% notifications.forEach(n=>{ %><a class="notification-card" href="<%= n.link||'/' %>"><strong><%= n.title %></strong><p><%= n.message %></p><small><%= new Date(n.createdAt).toLocaleString() %></small></a><% }) %></div><% } %></div>
