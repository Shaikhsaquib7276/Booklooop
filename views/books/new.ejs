<% layout("layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="book-form-page">
  <div class="book-form-header">
    <span class="book-form-eyebrow">Marketplace</span>
    <h1 class="book-form-title">Add a Book</h1>
    <p class="book-form-subtitle">Create a clean listing so other students can discover your book.</p>
  </div>

  <form action="/books" method="POST" class="needs-validation book-form-card" novalidate enctype="multipart/form-data" id="bookForm" data-ajax-form data-loader-icon="📚" data-loader-title="Uploading Book" data-loader-message="Saving your listing...">
    <div class="book-form-grid">
      <div class="book-form-field">
        <label for="bookTitle">Title</label>
        <input id="bookTitle" name="title" class="form-control" placeholder="e.g. Data Structures & Algorithms" required>
      </div>
      <div class="book-form-field">
        <label for="bookAuthor">Author</label>
        <input id="bookAuthor" name="author" class="form-control" placeholder="Author name" required>
      </div>
      <div class="book-form-field full">
        <label for="bookDescription">Description</label>
        <textarea id="bookDescription" name="description" class="form-control" placeholder="Mention edition, useful notes, highlights or any important details..." required></textarea>
      </div>
      <div class="book-form-field">
        <label for="bookPrice">Price (₹)</label>
        <input id="bookPrice" type="number" name="price" class="form-control" min="0" placeholder="500" required>
      </div>
      <div class="book-form-field">
        <label for="bookCondition">Condition</label>
        <select id="bookCondition" name="condition" class="form-select">
          <option>New</option><option>Like New</option><option>Good</option><option>Fair</option><option>Poor</option>
        </select>
      </div>
      <div class="book-form-field full">
        <label for="bookCategory">Category</label>
        <input id="bookCategory" name="category" class="form-control" placeholder="e.g. Programming, Engineering, Novel" required>
      </div>

      <div class="book-form-field full academic-listing-field">
        <div class="academic-listing-toggle">
          <div>
            <label class="mb-1">Academic book mapping</label>
            <div class="book-form-help">Link this listing to your course and semester so other students can find it through Smart Semester Finder.</div>
          </div>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="academicListing" name="academicListing" value="yes" checked>
            <label class="form-check-label" for="academicListing">This is an academic book</label>
          </div>
        </div>

        <div id="studentAcademicListing" class="academic-listing-panel">
          <% if (currentUser && currentUser.accountType === "student") { %>
            <div class="academic-profile-preview">
              <i class="bi bi-mortarboard"></i>
              <div>
                <strong><%= currentUser.college || "College not set" %></strong>
                <span><%= currentUser.degree || "Degree not set" %> · <%= currentUser.course || "Course not set" %></span>
                <span><%= currentUser.academicYear || "Academic year not set" %> · Year <%= currentUser.year || "—" %> · Semester <%= currentUser.semester || "—" %></span>
              </div>
            </div>
          <% } %>

          <div class="row g-3 mt-1">
            <div class="col-md-8">
              <label for="academicSubject">Subject</label>
              <input id="academicSubject" name="academicSubject" class="form-control" placeholder="e.g. Database Management Systems" <%= currentUser && currentUser.accountType === "student" ? "required" : "" %>>
            </div>
            <div class="col-md-4">
              <label for="academicSubjectCode">Subject code</label>
              <input id="academicSubjectCode" name="academicSubjectCode" class="form-control" placeholder="e.g. CSC501">
            </div>
          </div>

          <% if (currentUser && currentUser.accountType !== "student") { %>
            <div class="row g-3 mt-1">
              <div class="col-md-6"><label for="academicCollege">College</label><input id="academicCollege" name="academicCollege" class="form-control"></div>
              <div class="col-md-6"><label for="academicDegree">Degree</label><input id="academicDegree" name="academicDegree" class="form-control" placeholder="e.g. BSc"></div>
              <div class="col-md-6"><label for="academicCourse">Course</label><input id="academicCourse" name="academicCourse" class="form-control" placeholder="e.g. Computer Science"></div>
              <div class="col-md-6"><label for="academicYear">Academic Year</label><input id="academicYear" name="academicYear" class="form-control" placeholder="e.g. 2026-27"></div>
              <div class="col-md-3"><label for="academicYearNumber">Year</label><input id="academicYearNumber" name="academicYearNumber" type="number" min="1" max="10" class="form-control"></div>
              <div class="col-md-3"><label for="academicSemester">Semester</label><input id="academicSemester" name="academicSemester" type="number" min="1" max="20" class="form-control"></div>
              <div class="col-md-3"><label for="academicType">Type</label><select id="academicType" name="academicType" class="form-select"><option>Prescribed</option><option>Reference</option></select></div>
            </div>
          <% } else { %>
            <input type="hidden" name="academicType" value="Prescribed">
          <% } %>
        </div>
      </div>
      <div class="book-form-field full pickup-location-field">
        <div class="pickup-location-header">
          <div>
            <label for="pickupAddress">Pickup address line</label>
            <div class="book-form-help">Search an address, select the correct place, then drag the pin or click the map to fine-tune the exact pickup point.</div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="useCurrentPickupLocation"><i class="bi bi-crosshair me-1"></i>Use my location</button>
        </div>

        <div class="pickup-location-search">
          <input id="pickupLocationSearch" type="text" class="form-control" placeholder="Search building, college, area, street or landmark">
          <button type="button" class="btn btn-primary" id="pickupLocationSearchButton"><i class="bi bi-search me-1"></i>Find</button>
          <div id="pickupLocationSuggestions" class="pickup-location-suggestions" role="listbox"></div>
        </div>

        <input id="pickupAddress" name="addressLine" class="form-control mt-2" maxlength="300" placeholder="e.g. ABC College, Main Road, Boisar" required>

        <div id="pickupLocationMap" class="pickup-location-map" aria-label="Select pickup location on map"></div>

        <div class="pickup-location-coordinates-row">
          <span id="pickupLocationCoordinates" class="book-form-help">No precise pickup location selected yet.</span>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="centerPickupMap">Center map on selected pin</button>
        </div>

        <input id="bookLatitude" type="hidden" name="latitude">
        <input id="bookLongitude" type="hidden" name="longitude">
        <div id="pickupLocationStatus" class="book-form-help" aria-live="polite"></div>
      </div>
      <% if (currentUser && currentUser.accountType === "shop") { %><div class="book-form-field full"><label for="bookStock">Available stock</label><input id="bookStock" type="number" name="stock" min="1" value="1" class="form-control" required></div><% } %>
      <div class="book-form-field full">
        <label for="bookImages">Book Photos</label>
        <div class="book-image-upload">
          <input id="bookImages" type="file" name="images" class="form-control" accept="image/jpeg,image/png,image/webp" multiple>
          <div class="book-form-help">Upload up to 8 photos (front cover, back cover, pages, and condition details). The first photo becomes the cover. JPG, PNG, and WebP are supported.</div>
        </div>
      </div>
    </div>
    <div class="book-form-actions">
      <a href="/books" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
      <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Add Book</button>
    </div>
  </form>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/pickup-location.js"></script>

<script>
(() => {
  const toggle = document.getElementById("academicListing");
  const panel = document.getElementById("studentAcademicListing");
  const subject = document.getElementById("academicSubject");
  if (!toggle || !panel) return;
  const sync = () => {
    panel.classList.toggle("d-none", !toggle.checked);
    if (subject) subject.required = toggle.checked && <%= currentUser && currentUser.accountType === "student" ? "true" : "false" %>;
  };
  toggle.addEventListener("change", sync);
  sync();
})();
</script>