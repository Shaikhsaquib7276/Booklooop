<% layout("layouts/boilerplate") %>
<%
    const bookPhotos = book.images && book.images.length
        ? book.images
        : [{ url: book.image && book.image.url ? book.image.url : "/book.jpg" }];
    const carouselId = `bookGallery-${book._id}`;
%>

<div class="container py-5">

    <!-- Back Button -->
    <div class="mb-4">
        <a href="/books" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Books
        </a>
    </div>

    <!-- Book Details Card -->
    <div class="book-detail-shell">
        <div class="row g-0 align-items-stretch">

            <!-- Book Image Carousel -->
            <div class="col-lg-5 book-detail-media">
                <div class="book-image-card book-gallery-card">
                    <div id="<%= carouselId %>" class="carousel slide book-gallery-carousel" data-bs-ride="false">
                        <div class="carousel-inner">
                            <% bookPhotos.forEach((photo, index) => { %>
                                <div class="carousel-item <%= index === 0 ? "active" : "" %>">
                                    <img
                                        src="<%= photo.url %>"
                                        alt="<%= book.title %> - photo <%= index + 1 %>"
                                        class="d-block w-100 book-gallery-zoom-trigger"
                                        loading="<%= index === 0 ? "eager" : "lazy" %>"
                                        role="button"
                                        tabindex="0"
                                        data-bs-toggle="modal"
                                        data-bs-target="#bookImageZoomModal"
                                        data-image-src="<%= photo.url %>"
                                        data-image-alt="<%= book.title %> - photo <%= index + 1 %>"
                                        aria-label="Open photo <%= index + 1 %> in zoom viewer"
                                    >
                                </div>
                            <% }) %>
                        </div>

                        <% if (bookPhotos.length > 1) { %>
                            <button class="carousel-control-prev" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="prev" aria-label="Previous photo">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#<%= carouselId %>" data-bs-slide="next" aria-label="Next photo">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                            <div class="book-gallery-count"><span class="bi bi-images me-1"></span><%= bookPhotos.length %> photos</div>
                            <div class="carousel-indicators book-gallery-indicators">
                                <% bookPhotos.forEach((photo, index) => { %>
                                    <button type="button" data-bs-target="#<%= carouselId %>" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? "active" : "" %>" aria-current="<%= index === 0 ? "true" : "false" %>" aria-label="Go to photo <%= index + 1 %>"></button>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Book Information -->
            <div class="col-lg-7 book-detail-content">
                <%- include("./includes/bookInfo") %>
            </div>

        </div>
    </div>

    <!-- Seller -->
    <div class="mt-5">
        <%- include("./includes/sellerCard") %>
    </div>

    <!-- Related Books -->
    <div class="mt-5">
        <%- include("./includes/relatedBooks") %>
    </div>


<!-- Full-screen book photo viewer -->
<div class="modal fade book-image-zoom-modal" id="bookImageZoomModal" tabindex="-1" aria-labelledby="bookImageZoomTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="bookImageZoomTitle"><%= book.title %> — Photo viewer</h2>
                <div class="book-zoom-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="bookZoomOut" aria-label="Zoom out"><i class="bi bi-zoom-out"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="bookZoomReset">Reset</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="bookZoomIn" aria-label="Zoom in"><i class="bi bi-zoom-in"></i></button>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <img id="bookZoomImage" src="" alt="" class="book-zoom-image">
            </div>
            <div class="modal-footer">
                <small class="text-muted">Use the + and − buttons or scroll to zoom. Drag the image when zoomed in.</small>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    const modal = document.getElementById("bookImageZoomModal");
    const zoomImage = document.getElementById("bookZoomImage");
    const zoomIn = document.getElementById("bookZoomIn");
    const zoomOut = document.getElementById("bookZoomOut");
    const zoomReset = document.getElementById("bookZoomReset");
    if (!modal || !zoomImage) return;

    let scale = 1;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let offsetX = 0;
    let offsetY = 0;

    const render = () => {
        zoomImage.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
        zoomImage.style.cursor = scale > 1 ? (dragging ? "grabbing" : "grab") : "zoom-in";
    };
    const setScale = (next) => {
        scale = Math.min(4, Math.max(1, next));
        if (scale === 1) { offsetX = 0; offsetY = 0; }
        render();
    };

    modal.addEventListener("show.bs.modal", (event) => {
        const trigger = event.relatedTarget;
        if (!trigger) return;
        zoomImage.src = trigger.dataset.imageSrc || "";
        zoomImage.alt = trigger.dataset.imageAlt || "";
        setScale(1);
    });
    zoomIn.addEventListener("click", () => setScale(scale + 0.5));
    zoomOut.addEventListener("click", () => setScale(scale - 0.5));
    zoomReset.addEventListener("click", () => setScale(1));
    zoomImage.addEventListener("wheel", (event) => {
        event.preventDefault();
        setScale(scale + (event.deltaY < 0 ? 0.25 : -0.25));
    }, { passive: false });
    zoomImage.addEventListener("pointerdown", (event) => {
        if (scale <= 1) return;
        dragging = true;
        startX = event.clientX - offsetX;
        startY = event.clientY - offsetY;
        zoomImage.setPointerCapture(event.pointerId);
        render();
    });
    zoomImage.addEventListener("pointermove", (event) => {
        if (!dragging) return;
        offsetX = event.clientX - startX;
        offsetY = event.clientY - startY;
        render();
    });
    const stopDragging = () => { dragging = false; render(); };
    zoomImage.addEventListener("pointerup", stopDragging);
    zoomImage.addEventListener("pointercancel", stopDragging);
    modal.addEventListener("hidden.bs.modal", () => {
        zoomImage.src = "";
        setScale(1);
    });
})();
</script>

</div>
