<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <!-- Back Button -->
    <div class="mb-4">
        <a href="/books" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Books
        </a>
    </div>

    <!-- Book Details Card -->
    <div class="book-detail-shell">
        <div class="row g-0 align-items-stretch">

            <!-- Book Image -->
            <div class="col-lg-5 book-detail-media">
                <div class="book-image-card">
                    <img
                        src="<%= book.image.url %>"
                        alt="<%= book.title %>"
                        class="img-fluid"
                    >
                </div>
            </div>

            <!-- Book Information -->
            <div class="col-lg-7 book-detail-content">
                <%- include("./includes/bookInfo") %>
            </div>

        </div>
    </div>

    <!-- Seller -->
    <div class="mt-5">
        <%- include("./includes/sellerCard") %>
    </div>

    <!-- Related Books -->
    <div class="mt-5">
        <%- include("./includes/relatedBooks") %>
    </div>

</div>