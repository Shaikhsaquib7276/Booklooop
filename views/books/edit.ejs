<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="book-form-page">
  <div class="book-form-header">
    <span class="book-form-eyebrow">Manage listing</span>
    <h1 class="book-form-title">Edit Book</h1>
    <p class="book-form-subtitle">Update your listing details, condition, status or add more book photos.</p>
  </div>

  <form id="bookForm" action="/books/<%= book._id %>?_method=PUT" method="POST" class="needs-validation book-form-card" data-pickup-location-form novalidate enctype="multipart/form-data" data-loader-icon="📚" data-loader-title="Updating Book" data-loader-message="Saving your changes...">
    <div class="book-form-grid">
      <div class="book-form-field">
        <label for="editTitle">Title</label>
        <input id="editTitle" type="text" name="title" class="form-control" value="<%= book.title %>" required>
      </div>
      <div class="book-form-field">
        <label for="editAuthor">Author</label>
        <input id="editAuthor" type="text" name="author" class="form-control" value="<%= book.author %>" required>
      </div>
      <div class="book-form-field full">
        <label for="editDescription">Description</label>
        <textarea id="editDescription" name="description" class="form-control" rows="5" required><%= book.description %></textarea>
      </div>
      <div class="book-form-field">
        <label for="editPrice">Price (₹)</label>
        <input id="editPrice" type="number" name="price" class="form-control" min="0" value="<%= book.price %>" required>
      </div>
      <div class="book-form-field">
        <label for="editCategory">Category</label>
        <input id="editCategory" type="text" name="category" class="form-control" value="<%= book.category %>" required>
      </div>
      <div class="book-form-field">
        <label for="editCondition">Condition</label>
        <select id="editCondition" name="condition" class="form-select">
          <option <%=book.condition==="New" ? "selected" : "" %>>New</option>
          <option <%=book.condition==="Like New" ? "selected" : "" %>>Like New</option>
          <option <%=book.condition==="Good" ? "selected" : "" %>>Good</option>
          <option <%=book.condition==="Fair" ? "selected" : "" %>>Fair</option>
          <option <%=book.condition==="Poor" ? "selected" : "" %>>Poor</option>
        </select>
      </div>
      <div class="book-form-field">
        <label for="editStatus">Listing Status</label>
        <select id="editStatus" name="status" class="form-select">
          <option value="Available" <%=book.status==="Available" ? "selected" : "" %>>Available</option>
          <option value="Reserved" <%=book.status==="Reserved" ? "selected" : "" %>>Reserved</option>
          <option value="Sold" <%=book.status==="Sold" ? "selected" : "" %>>Sold</option>
        </select>
      </div>
      <div class="book-form-field full pickup-location-field">
        <div class="pickup-location-header">
          <div>
            <label for="pickupAddress">Pickup address line</label>
            <div class="book-form-help">Search the pickup place, select the correct result, then drag the pin or click the map to fine-tune it.</div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="useCurrentPickupLocation"><i class="bi bi-crosshair me-1"></i>Use my location</button>
        </div>

        <div class="pickup-location-search">
          <input id="pickupLocationSearch" type="text" class="form-control" placeholder="Search building, college, area, street or landmark">
          <button type="button" class="btn btn-primary" id="pickupLocationSearchButton"><i class="bi bi-search me-1"></i>Find</button>
          <div id="pickupLocationSuggestions" class="pickup-location-suggestions" role="listbox"></div>
        </div>

        <input id="pickupAddress" name="addressLine" class="form-control mt-2" maxlength="300" value="<%= book.addressLine || '' %>" placeholder="e.g. ABC College, Main Road, Boisar" required>

        <div id="pickupLocationMap" class="pickup-location-map" aria-label="Select pickup location on map"></div>

        <div class="pickup-location-coordinates-row">
          <span id="pickupLocationCoordinates" class="book-form-help">No precise pickup location selected yet.</span>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="centerPickupMap">Center map on selected pin</button>
        </div>

        <input id="bookLatitude" type="hidden" name="latitude" value="<%= book.location && book.location.coordinates ? book.location.coordinates[1] : '' %>">
        <input id="bookLongitude" type="hidden" name="longitude" value="<%= book.location && book.location.coordinates ? book.location.coordinates[0] : '' %>">
        <div id="pickupLocationStatus" class="book-form-help" aria-live="polite"></div>
      </div>
      <% if (currentUser && currentUser.accountType === "shop") { %><div class="book-form-field full"><label for="editStock">Available stock</label><input id="editStock" type="number" name="stock" min="0" value="<%= book.stock || 0 %>" class="form-control" required></div><% } %>
      <div class="book-form-field full">
        <label>Current Photos</label>
        <div class="book-current-gallery">
          <% const currentPhotos = book.images && book.images.length ? book.images : (book.image && book.image.url ? [book.image] : []); %>
          <% currentPhotos.forEach((photo) => { %>
            <img src="<%= photo.url %>" alt="Current photo of <%= book.title %>" class="book-current-image">
          <% }) %>
        </div>
        <label for="editImages">Add More Photos</label>
        <div class="book-image-upload">
          <input id="editImages" type="file" name="images" class="form-control" accept="image/jpeg,image/png,image/webp" multiple>
          <div class="book-form-help">Select up to 8 new photos per upload. On Windows, use Ctrl-click to select separate files or Shift-click to select a range. Existing photos will be kept.</div>
          <div id="editImageSelection" class="book-image-selection" aria-live="polite">No new photos selected.</div>
          <div id="editImagePreview" class="book-image-preview" aria-label="Selected photo previews"></div>
        </div>
      </div>
    </div>
    <div class="book-form-actions">
      <a href="/books/<%= book._id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
      <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-2"></i>Update Book</button>
    </div>
  </form>
</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/pickup-location.js"></script>

<script>
(() => {
  const input = document.getElementById("editImages");
  const selection = document.getElementById("editImageSelection");
  const preview = document.getElementById("editImagePreview");
  if (!input || !selection || !preview) return;

  input.addEventListener("change", () => {
    const files = Array.from(input.files || []);
    preview.replaceChildren();

    if (files.length > 8) {
      selection.textContent = "Please select no more than 8 photos.";
      input.setCustomValidity("Select no more than 8 photos.");
      return;
    }

    input.setCustomValidity("");
    selection.textContent = files.length
      ? files.length + (files.length === 1 ? " new photo selected." : " new photos selected.")
      : "No new photos selected.";

    files.forEach((file) => {
      if (!file.type.startsWith("image/")) return;
      const url = URL.createObjectURL(file);
      const image = document.createElement("img");
      image.src = url;
      image.alt = file.name;
      image.className = "book-selected-preview";
      image.onload = () => URL.revokeObjectURL(url);
      preview.appendChild(image);
    });
  });
})();
</script>
