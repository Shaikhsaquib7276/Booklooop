<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="book-form-page">
  <div class="book-form-header">
    <span class="book-form-eyebrow">Manage listing</span>
    <h1 class="book-form-title">Edit Book</h1>
    <p class="book-form-subtitle">Update your listing details, condition, status or add more book photos.</p>
  </div>

  <form id="bookForm" action="/books/<%= book._id %>?_method=PUT" method="POST" class="needs-validation book-form-card" data-pickup-location-form novalidate enctype="multipart/form-data" data-loader-icon="📚" data-loader-title="Updating Book" data-loader-message="Saving your changes...">
    <div class="book-form-grid">
      <div class="book-form-field">
        <label for="editTitle">Title</label>
        <input id="editTitle" type="text" name="title" class="form-control" value="<%= book.title %>" required>
      </div>
      <div class="book-form-field">
        <label for="editAuthor">Author</label>
        <input id="editAuthor" type="text" name="author" class="form-control" value="<%= book.author %>" required>
      </div>
      <div class="book-form-field full">
        <label for="editDescription">Description</label>
        <textarea id="editDescription" name="description" class="form-control" rows="5" required><%= book.description %></textarea>
      </div>
      <div class="book-form-field">
        <label for="editPrice">Price (₹)</label>
        <input id="editPrice" type="number" name="price" class="form-control" min="0" value="<%= book.price %>" required>
      </div>
      <div class="book-form-field">
        <label for="editCategory">Category</label>
        <input id="editCategory" type="text" name="category" class="form-control" value="<%= book.category %>" required>
      </div>
      <div class="book-form-field">
        <label for="editCondition">Condition</label>
        <select id="editCondition" name="condition" class="form-select">
          <option <%=book.condition==="New" ? "selected" : "" %>>New</option>
          <option <%=book.condition==="Like New" ? "selected" : "" %>>Like New</option>
          <option <%=book.condition==="Good" ? "selected" : "" %>>Good</option>
          <option <%=book.condition==="Fair" ? "selected" : "" %>>Fair</option>
          <option <%=book.condition==="Poor" ? "selected" : "" %>>Poor</option>
        </select>
      </div>
      <div class="book-form-field">
        <label for="editStatus">Listing Status</label>
        <select id="editStatus" name="status" class="form-select">
          <option value="Available" <%=book.status==="Available" ? "selected" : "" %>>Available</option>
          <option value="Reserved" <%=book.status==="Reserved" ? "selected" : "" %>>Reserved</option>
          <option value="Sold" <%=book.status==="Sold" ? "selected" : "" %>>Sold</option>
        </select>
      </div>
      <div class="book-form-field full academic-listing-field">
        <div class="academic-listing-toggle">
          <div>
            <label class="mb-1">Academic book mapping</label>
            <div class="book-form-help">Keep this listing linked to the academic record used by Smart Semester Finder.</div>
          </div>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="academicListing" name="academicListing" value="yes" <%= book.academicBook ? "checked" : "" %>>
            <label class="form-check-label" for="academicListing">This is an academic book</label>
          </div>
        </div>

        <div id="studentAcademicListing" class="academic-listing-panel <%= book.academicBook ? "" : "d-none" %>">
          <% if (currentUser && currentUser.accountType === "student") { %>
            <div class="academic-profile-preview">
              <i class="bi bi-mortarboard"></i>
              <div>
                <strong><%= currentUser.college || "College not set" %></strong>
                <span><%= currentUser.degree || "Degree not set" %> · <%= currentUser.course || "Course not set" %></span>
                <span><%= currentUser.academicYear || "Academic year not set" %> · Year <%= currentUser.year || "—" %> · Semester <%= currentUser.semester || "—" %></span>
              </div>
            </div>
          <% } %>

          <% 
            const profileSubjects = currentUser && currentUser.accountType === "student" && Array.isArray(currentUser.academicSubjects)
              ? currentUser.academicSubjects
              : [];
            const currentSubjectInProfile = book.academicBook && profileSubjects.some(item =>
              String(item.subject || "").trim().toLowerCase() === String(book.academicBook.subject || "").trim().toLowerCase() &&
              String(item.subjectCode || "").trim().toLowerCase() === String(book.academicBook.subjectCode || "").trim().toLowerCase()
            );
          %>
          <div class="row g-3 mt-1">
            <% if (currentUser && currentUser.accountType === "student") { %>
              <div class="col-md-8">
                <label for="academicSubject">Subject</label>
                <select id="academicSubject" name="academicSubject" class="form-select" <%= book.academicBook && profileSubjects.length ? "required" : "" %>>
                  <option value="">Select a subject from your profile</option>
                  <% profileSubjects.forEach(item => { %>
                    <option value="<%= item.subject %>" data-subject-code="<%= item.subjectCode %>"
                      <%= book.academicBook && String(item.subject || "").trim().toLowerCase() === String(book.academicBook.subject || "").trim().toLowerCase() && String(item.subjectCode || "").trim().toLowerCase() === String(book.academicBook.subjectCode || "").trim().toLowerCase() ? "selected" : "" %>>
                      <%= item.subject %>
                    </option>
                  <% }) %>
                </select>
                <% if (book.academicBook && !currentSubjectInProfile) { %>
                  <div class="form-text text-warning">This listing's subject is not in your current profile. Update your academic profile before changing this academic mapping.</div>
                <% } %>
              </div>
              <div class="col-md-4">
                <label for="academicSubjectCode">Subject code</label>
                <input id="academicSubjectCode" name="academicSubjectCode" class="form-control" value="<%= book.academicBook ? book.academicBook.subjectCode : "" %>" placeholder="Selected automatically" readonly>
              </div>
            <% } else { %>
              <div class="col-md-8">
                <label for="academicSubject">Subject</label>
                <input id="academicSubject" name="academicSubject" class="form-control" value="<%= book.academicBook ? book.academicBook.subject : "" %>" placeholder="e.g. Database Management Systems">
              </div>
              <div class="col-md-4">
                <label for="academicSubjectCode">Subject code</label>
                <input id="academicSubjectCode" name="academicSubjectCode" class="form-control" value="<%= book.academicBook ? book.academicBook.subjectCode : "" %>" placeholder="e.g. CSC501">
              </div>
            <% } %>
          </div>

          <% if (currentUser && currentUser.accountType !== "student") { %>
            <div class="row g-3 mt-1">
              <div class="col-md-6"><label for="academicCollege">College</label><input id="academicCollege" name="academicCollege" class="form-control" value="<%= book.academicBook ? book.academicBook.college : '' %>"></div>
              <div class="col-md-6"><label for="academicDegree">Degree</label><input id="academicDegree" name="academicDegree" class="form-control" value="<%= book.academicBook ? book.academicBook.degree : '' %>" placeholder="e.g. BSc"></div>
              <div class="col-md-6"><label for="academicCourse">Course</label><input id="academicCourse" name="academicCourse" class="form-control" value="<%= book.academicBook ? book.academicBook.course : '' %>" placeholder="e.g. Computer Science"></div>
              <div class="col-md-6"><label for="academicYear">Academic Year</label><input id="academicYear" name="academicYear" class="form-control" value="<%= book.academicBook ? book.academicBook.academicYear : '' %>" placeholder="e.g. 2026-27"></div>
              <div class="col-md-3"><label for="academicYearNumber">Year</label><input id="academicYearNumber" name="academicYearNumber" type="number" min="1" max="10" class="form-control" value="<%= book.academicBook ? book.academicBook.year : '' %>"></div>
              <div class="col-md-3"><label for="academicSemester">Semester</label><input id="academicSemester" name="academicSemester" type="number" min="1" max="20" class="form-control" value="<%= book.academicBook ? book.academicBook.semester : '' %>"></div>
              <div class="col-md-3"><label for="academicType">Type</label><select id="academicType" name="academicType" class="form-select"><option <%= !book.academicBook || book.academicBook.type!=="Reference" ? "selected" : "" %>>Prescribed</option><option <%= book.academicBook && book.academicBook.type==="Reference" ? "selected" : "" %>>Reference</option></select></div>
            </div>
          <% } else { %>
            <input type="hidden" name="academicType" value="<%= book.academicBook && book.academicBook.type==="Reference" ? "Reference" : "Prescribed" %>">
          <% } %>
        </div>
      </div>

      <div class="book-form-field full pickup-location-field">
        <div class="pickup-location-header">
          <div>
            <label for="pickupAddress">Pickup address line</label>
            <div class="book-form-help">Search the pickup place, select the correct result, then drag the pin or click the map to fine-tune it.</div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" id="useCurrentPickupLocation"><i class="bi bi-crosshair me-1"></i>Use my location</button>
        </div>

        <div class="pickup-location-search">
          <input id="pickupLocationSearch" type="text" class="form-control" placeholder="Search building, college, area, street or landmark">
          <button type="button" class="btn btn-primary" id="pickupLocationSearchButton"><i class="bi bi-search me-1"></i>Find</button>
          <div id="pickupLocationSuggestions" class="pickup-location-suggestions" role="listbox"></div>
        </div>

        <input id="pickupAddress" name="addressLine" class="form-control mt-2" maxlength="300" value="<%= book.addressLine || '' %>" placeholder="e.g. ABC College, Main Road, Boisar" required>

        <div id="pickupLocationMap" class="pickup-location-map" aria-label="Select pickup location on map"></div>

        <div class="pickup-location-coordinates-row">
          <span id="pickupLocationCoordinates" class="book-form-help">No precise pickup location selected yet.</span>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="centerPickupMap">Center map on selected pin</button>
        </div>

        <input id="bookLatitude" type="hidden" name="latitude" value="<%= book.location && book.location.coordinates ? book.location.coordinates[1] : '' %>">
        <input id="bookLongitude" type="hidden" name="longitude" value="<%= book.location && book.location.coordinates ? book.location.coordinates[0] : '' %>">
        <div id="pickupLocationStatus" class="book-form-help" aria-live="polite"></div>
      </div>
      <% if (currentUser && currentUser.accountType === "shop") { %><div class="book-form-field full"><label for="editStock">Available stock</label><input id="editStock" type="number" name="stock" min="0" value="<%= book.stock || 0 %>" class="form-control" required></div><% } %>
      <div class="book-form-field full">
        <label>Current Photos</label>
        <div class="book-current-gallery">
          <% const currentPhotos = book.images && book.images.length ? book.images : (book.image && book.image.url ? [book.image] : []); %>
          <% currentPhotos.forEach((photo) => { %>
            <img src="<%= photo.url %>" alt="Current photo of <%= book.title %>" class="book-current-image">
          <% }) %>
        </div>
        <label for="editImages">Add More Photos</label>
        <div class="book-image-upload">
          <input id="editImages" type="file" name="images" class="form-control" accept="image/jpeg,image/png,image/webp" multiple>
          <div class="book-form-help">Select up to 8 new photos per upload. On Windows, use Ctrl-click to select separate files or Shift-click to select a range. Existing photos will be kept.</div>
          <div id="editImageSelection" class="book-image-selection" aria-live="polite">No new photos selected.</div>
          <div id="editImagePreview" class="book-image-preview" aria-label="Selected photo previews"></div>
        </div>
      </div>
    </div>
    <div class="book-form-actions">
      <a href="/books/<%= book._id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
      <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-2"></i>Update Book</button>
    </div>
  </form>
</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/pickup-location.js"></script>

<script>
(() => {
  const input = document.getElementById("editImages");
  const selection = document.getElementById("editImageSelection");
  const preview = document.getElementById("editImagePreview");
  if (!input || !selection || !preview) return;

  input.addEventListener("change", () => {
    const files = Array.from(input.files || []);
    preview.replaceChildren();

    if (files.length > 8) {
      selection.textContent = "Please select no more than 8 photos.";
      input.setCustomValidity("Select no more than 8 photos.");
      return;
    }

    input.setCustomValidity("");
    selection.textContent = files.length
      ? files.length + (files.length === 1 ? " new photo selected." : " new photos selected.")
      : "No new photos selected.";

    files.forEach((file) => {
      if (!file.type.startsWith("image/")) return;
      const url = URL.createObjectURL(file);
      const image = document.createElement("img");
      image.src = url;
      image.alt = file.name;
      image.className = "book-selected-preview";
      image.onload = () => URL.revokeObjectURL(url);
      preview.appendChild(image);
    });
  });
})();
</script>

<script>
(() => {
  const button = document.getElementById("useEditBookLocation");
  const status = document.getElementById("editBookLocationStatus");
  const lat = document.getElementById("editLatitude");
  const lng = document.getElementById("editLongitude");
  if (!button || !status || !lat || !lng) return;

  button.addEventListener("click", () => {
    if (!navigator.geolocation) {
      status.textContent = "Geolocation is not supported by this browser.";
      return;
    }
    button.disabled = true;
    status.textContent = "Getting your pickup location…";
    navigator.geolocation.getCurrentPosition(
      position => {
        lat.value = position.coords.latitude.toFixed(6);
        lng.value = position.coords.longitude.toFixed(6);
        status.textContent = "Pickup location updated. Click Update Book to save it.";
        button.disabled = false;
      },
      error => {
        console.error("Edit book location error:", error);
        status.textContent = "Location permission was denied or unavailable. Enter coordinates manually.";
        button.disabled = false;
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  });
})();
</script>

<script>
(() => {
  const toggle = document.getElementById("academicListing");
  const panel = document.getElementById("studentAcademicListing");
  const subject = document.getElementById("academicSubject");
  const subjectCode = document.getElementById("academicSubjectCode");
  if (!toggle || !panel) return;

  const syncCode = () => {
    if (!subject || !subjectCode || subject.tagName !== "SELECT") return;
    const option = subject.options[subject.selectedIndex];
    subjectCode.value = option && option.dataset ? (option.dataset.subjectCode || "") : "";
  };

  if (subject && subject.tagName === "SELECT") {
    subject.addEventListener("change", syncCode);
    syncCode();
  }

  const sync = () => {
    panel.classList.toggle("d-none", !toggle.checked);
    if (subject) subject.required = toggle.checked && subject.tagName === "SELECT";
  };

  toggle.addEventListener("change", sync);
  sync();
})();
</script>