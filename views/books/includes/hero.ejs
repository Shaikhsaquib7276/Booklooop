<!-- ================= HERO SECTION ================= -->

<section class="market-hero">

    <div class="container">

        <div class="row align-items-center">

            <!-- Left Side -->

            <div class="col-lg-7">

                <span class="badge bg-light text-primary px-3 py-2 mb-3 rounded-pill">

                    📚 Student Marketplace

                </span>

                <h1 class="display-4 fw-bold mb-3">

                    Browse Second-Hand Books

                </h1>

                <p class="lead text-light mb-4">

                    Find affordable books from students across different
                    categories. Save money while helping someone else.

                </p>

                <div class="d-flex flex-wrap gap-3">

                    <a
                        href="/books/new"
                        class="btn btn-light btn-lg">

                        <i class="bi bi-plus-circle me-2"></i>

                        Sell Your Book

                    </a>

                    <a
                        href="#books"
                        class="btn btn-outline-light btn-lg">

                        <i class="bi bi-book me-2"></i>

                        Browse Books

                    </a>

                </div>

                <!-- Statistics -->

                <div class="row mt-5">

                    <div class="col-4">

                        <h3 class="fw-bold">

                            <%= books.length %>+

                        </h3>

                        <p class="mb-0">

                            Books

                        </p>

                    </div>

                    <div class="col-4">

                        <h3 class="fw-bold">

                            500+

                        </h3>

                        <p class="mb-0">

                            Students

                        </p>

                    </div>

                    <div class="col-4">

                        <h3 class="fw-bold">

                            100+

                        </h3>

                        <p class="mb-0">

                            Sellers

                        </p>

                    </div>

                </div>

            </div>

            <!-- Right Side -->

            <div class="col-lg-5 text-center mt-5 mt-lg-0">

                <div class="hero-image">

                    <i class="bi bi-book-half"></i>

                </div>

            </div>

        </div>

    </div>

</section>