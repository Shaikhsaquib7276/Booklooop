<div class="col-xl-4 col-lg-6 col-md-6 mb-4">
  <article class="card marketplace-card h-100">
    <div class="book-image">
      <img src="<%= book.image.url %>" alt="<%= book.title %>" loading="lazy">
      <% if (currentUser) { %>
        <div class="book-card-wishlist">
          <%- include("../../includes/wishlistButton", { book }) %>
        </div>
      <% } %>
      <span class="badge bg-primary category-badge"><%= book.category %></span>
    </div>

    <div class="card-body d-flex flex-column">
      <h5 class="book-title" title="<%= book.title %>"><%= book.title %></h5>
      <p class="book-card-author"><i class="bi bi-person-fill me-1"></i><%= book.author %></p>
      <p class="book-description"><%= book.description %></p>

      <div class="book-card-meta">
        <span class="badge bg-success"><%= book.condition %></span>
        <% if (book.status === "Available") { %>
          <span class="book-status available">Available</span>
        <% } else if (book.status === "Reserved") { %>
          <span class="book-status reserved">Reserved</span>
        <% } else if (book.status === "Sold") { %>
          <span class="book-status sold">Sold</span>
        <% } %>
      </div>

      <div class="book-card-bottom">
        <div class="book-card-price">₹<%= book.price %></div>
        <span class="book-card-seller"><i class="bi bi-person-circle me-1"></i><%= book.owner ? book.owner.username : "Unknown Seller" %></span>
      </div>

      <a href="/books/<%= book._id %>" class="btn btn-primary w-100 book-card-action">
        View Details <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>
  </article>
</div>