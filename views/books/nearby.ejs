<% layout("layouts/boilerplate") %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/css/nearby-books.css">

<section class="nearby-page">
  <header class="nearby-header">
    <span class="nearby-eyebrow">BookLoop discovery</span>
    <h1>Nearby Book Finder</h1>
    <p>Find and compare matching books from students and local bookstores.</p>
  </header>

  <form class="nearby-search card p-3 mb-4" action="/nearby-books" method="get" id="nearbySearch">
    <div class="row g-2 align-items-end">
      <div class="col-md-7">
        <label class="form-label" for="nearbyTitle">Book title</label>
        <input class="form-control" id="nearbyTitle" name="q" value="<%= q %>" placeholder="e.g. Database System Concepts">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="nearbyRadius">Search radius</label>
        <select class="form-select" id="nearbyRadius" name="radius">
          <% [1,5,10,20,50].forEach(value => { %>
            <option value="<%= value %>" <%= radius === value ? "selected" : "" %>><%= value %> km</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Search</button>
      </div>
    </div>
    <input type="hidden" name="lat" id="nearbyLat" value="<%= searchLat %>">
    <input type="hidden" name="lng" id="nearbyLng" value="<%= searchLng %>">
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
      <button type="button" class="btn btn-outline-primary btn-sm" id="useMyLocation"><i class="bi bi-crosshair me-1"></i>Use my location</button>
      <span class="small text-secondary" id="locationStatus" aria-live="polite"><%= hasLocation ? "Location ready" : "Location is used only after you allow access." %></span>
    </div>
  </form>

  <% if (locationError) { %>
    <div class="alert alert-info"><%= locationError %></div>
  <% } %>

  <div class="nearby-results-heading">
    <div><h2>Matching sellers</h2><p>Compare price, condition, availability and distance.</p></div>
    <span class="badge text-bg-light"><%= books.length %> results</span>
  </div>

  <div id="nearbyMap" class="nearby-map mb-4" aria-label="Map showing your location and nearby book sellers"></div>

  <% if (hasLocation && books.length) { %>
    <div class="table-responsive nearby-table-wrap">
      <table class="table align-middle nearby-table">
        <thead><tr><th>Book / Seller</th><th>Distance</th><th>Price</th><th>Condition</th><th>Availability</th><th>Seller type</th></tr></thead>
        <tbody>
          <% books.forEach(book => { %>
            <tr>
              <td><a class="nearby-book-title" href="/books/<%= book._id %>"><%= book.title %></a><div class="small text-secondary"><%= book.owner ? book.owner.username : "Seller" %></div></td>
              <td><%= book.distanceKm === null ? "—" : book.distanceKm.toFixed(1) + " km" %></td>
              <td class="fw-semibold">₹<%= Number(book.price).toLocaleString("en-IN") %></td>
              <td><%= book.condition || "Not specified" %></td>
              <td><span class="badge text-bg-success">Available</span></td>
              <td><span class="badge text-bg-light"><%= book.sellerType === "shop" ? "Bookshop" : "Student" %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else if (hasLocation) { %>
    <div class="nearby-empty"><i class="bi bi-book"></i><h3>No nearby matches</h3><p>Try another title, author, or category, or increase the search radius. The map above shows your current location.</p></div>
  <% } else { %>
    <div class="nearby-empty"><i class="bi bi-geo-alt"></i><h3>Map is ready</h3><p>Allow location access to load nearby book listings on the map.</p></div>
  <% } %>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(() => {
  const button = document.getElementById("useMyLocation");
  const status = document.getElementById("locationStatus");
  const form = document.getElementById("nearbySearch");
  const title = document.getElementById("nearbyTitle");
  const lat = document.getElementById("nearbyLat");
  const lng = document.getElementById("nearbyLng");

  const DEFAULT_CENTER = [20.5937, 78.9629];

  function validCoordinates(latitude, longitude) {
    return Number.isFinite(latitude) &&
      Number.isFinite(longitude) &&
      Math.abs(latitude) <= 90 &&
      Math.abs(longitude) <= 180;
  }

  function saveLocation(latitude, longitude) {
    lat.value = Number(latitude).toFixed(6);
    lng.value = Number(longitude).toFixed(6);
    try {
      localStorage.setItem("bookloopNearbyLat", lat.value);
      localStorage.setItem("bookloopNearbyLng", lng.value);
    } catch (_) {}
  }

  function submitWithLocation() {
    form.submit();
  }

  function requestLocation(autoSubmit = true) {
    if (!navigator.geolocation) {
      status.textContent = "Location is not supported. Enter coordinates manually below.";
      return;
    }

    status.textContent = "Getting your location…";

    navigator.geolocation.getCurrentPosition(
      position => {
        saveLocation(position.coords.latitude, position.coords.longitude);
        status.textContent = "Location ready.";
        if (autoSubmit) submitWithLocation();
      },
      error => {
        console.error("Nearby geolocation error:", error);

        if (error.code === 1) {
          status.textContent = "Location permission is blocked. Allow it for localhost, then click Use my location again.";
        } else if (error.code === 2) {
          status.textContent = "Your location could not be determined. Use manual coordinates below.";
        } else if (error.code === 3) {
          status.textContent = "Location request timed out. Try again or enter coordinates manually.";
        } else {
          status.textContent = "Could not get your location. Use manual coordinates below.";
        }
      },
      {
        enableHighAccuracy: false,
        timeout: 10000,
        maximumAge: 300000
      }
    );
  }

  button?.addEventListener("click", () => requestLocation(true));

  form.addEventListener("submit", event => {
    if (validCoordinates(Number(lat.value), Number(lng.value))) return;
    event.preventDefault();
    requestLocation(true);
  });

  // Reuse the last location for a smoother local development experience.
  if (!validCoordinates(Number(lat.value), Number(lng.value))) {
    try {
      const savedLat = Number(localStorage.getItem("bookloopNearbyLat"));
      const savedLng = Number(localStorage.getItem("bookloopNearbyLng"));
      if (validCoordinates(savedLat, savedLng)) {
        saveLocation(savedLat, savedLng);
        if (title.value.trim() || !lat.value || !lng.value) {
          submitWithLocation();
          return;
        }
      }
    } catch (_) {}
  }

  // On the first visit, ask for location so the initial page can show nearby listings.
  if (!validCoordinates(Number(lat.value), Number(lng.value))) {
    requestLocation(true);
  }

  const mapElement = document.getElementById("nearbyMap");
  if (!mapElement || !window.L) return;

  const hasServerLocation = validCoordinates(Number(lat.value), Number(lng.value));
  const center = hasServerLocation
    ? [Number(lat.value), Number(lng.value)]
    : DEFAULT_CENTER;

  const map = L.map(mapElement).setView(center, hasServerLocation ? 13 : 5);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19
  }).addTo(map);

  let userMarker = null;

  if (hasServerLocation) {
    userMarker = L.marker(center).addTo(map).bindPopup("<strong>Your location</strong>");
  }

  const points = <%- JSON.stringify(
    books
      .filter(book => book.location && book.location.coordinates && book.location.coordinates.length === 2)
      .map(book => ({
        lat: book.location.coordinates[1],
        lng: book.location.coordinates[0],
        title: book.title,
        price: book.price,
        id: book._id,
        seller: book.owner ? book.owner.username : "Seller",
        type: book.sellerType === "shop" ? "Bookshop" : "Student"
      }))
  ) %>;

  const markers = points.map(point => {
    return L.marker([point.lat, point.lng]).bindPopup(
      '<strong>' + escapeHtml(point.title) + '</strong><br>₹' +
      Number(point.price).toLocaleString("en-IN") +
      '<br>' + escapeHtml(point.seller) + ' · ' + escapeHtml(point.type) +
      '<br><a href="/books/' + encodeURIComponent(point.id) + '">View book</a>'
    );
  });

  const markerLayer = L.featureGroup(markers).addTo(map);

  if (markers.length && userMarker) {
    map.fitBounds(L.featureGroup([userMarker, ...markers]).getBounds().pad(0.15));
  } else if (markers.length) {
    map.fitBounds(markerLayer.getBounds().pad(0.15));
  } else if (userMarker) {
    map.setView(center, 13);
  }

  setTimeout(() => map.invalidateSize(), 100);

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char]));
  }
})();
</script>
