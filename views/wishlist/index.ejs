<% layout("layouts/boilerplate") %>

<div class="container py-4 py-md-5 user-page">
    <div class="user-page-header">
        <div>
            <span class="user-eyebrow">Saved for later</span>
            <h1>❤️ My Wishlist</h1>
            <p>Keep your favorite books in one place.</p>
        </div>
        <a href="/books" class="btn btn-primary"><i class="bi bi-search me-2"></i>Browse Books</a>
    </div>

    <% if(books.length===0){ %>
        <div class="user-empty">
            <div class="user-empty-icon"><i class="bi bi-heart"></i></div>
            <h3>Your wishlist is empty</h3>
            <p>Found a book you like? Save it here and come back when you're ready to buy.</p>
            <a href="/books" class="btn btn-primary"><i class="bi bi-search me-2"></i>Find Books</a>
        </div>
    <% } else { %>
        <div class="row g-3 g-md-4">
            <% books.forEach(book=>{ %>
                <div class="col-lg-4 col-md-6">
                    <article class="wishlist-card">
                        <div class="user-book-image">
                            <img src="<%= book.image.url %>" alt="<%= book.title %>">
                        </div>
                        <div class="user-book-body">
                            <h5><%= book.title %></h5>
                            <p class="user-book-author mb-0"><%= book.author %></p>
                            <div class="user-book-price">₹<%= book.price %></div>
                            <span class="badge bg-success"><%= book.condition %></span>
                            <p class="user-book-seller mt-3 mb-0"><i class="bi bi-person me-1"></i>Seller: <strong><%= book.owner.username %></strong></p>
                        </div>
                        <div class="user-book-footer">
                            <a href="/books/<%= book._id %>" class="btn btn-outline-primary"><i class="bi bi-eye me-1"></i>View Book</a>
                            <% if(currentUser){ %>
                                <%- include("../includes/wishlistButton", { book }) %>
                            <% } %>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>