<% layout("layouts/boilerplate") %>
<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="fw-bold">Exchange Books</h1><p class="text-muted mb-0">Offer a book you own in exchange for another student's book.</p></div>
    <a class="btn btn-outline-primary" href="/exchange/mine">My exchange offers</a>
  </div>
  <% if (!myBooks.length) { %>
    <div class="alert alert-info">You need an available book listed under your account before you can make an exchange offer. <a href="/books/new">List a book</a>.</div>
  <% } %>
  <div class="row g-4">
    <% books.forEach(book => { const preselected = String(requestedBookId || "") === String(book._id); %>
      <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <img src="<%= book.image && book.image.url ? book.image.url : '/book.jpg' %>" class="card-img-top" alt="<%= book.title %>" style="height:220px;object-fit:contain;padding:1rem">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= book.title %></h5><p class="text-muted mb-1"><%= book.author %></p>
            <small class="text-muted mb-3">Owner: <%= book.owner ? book.owner.username : "Student" %></small>
            <% if (preselected) { %><span class="badge bg-primary align-self-start mb-3">Selected from book page</span><% } %>
            <form action="/exchange" method="POST" class="mt-auto">
              <input type="hidden" name="requestedBookId" value="<%= book._id %>">
              <label class="form-label" for="offer-<%= book._id %>">Offer one of your books</label>
              <select class="form-select mb-3" id="offer-<%= book._id %>" name="offeredBookId" required <%= myBooks.length ? "" : "disabled" %>>
                <option value="">Choose your book</option>
                <% myBooks.forEach(mine => { %><option value="<%= mine._id %>"><%= mine.title %> — <%= mine.condition %></option><% }) %>
              </select>
              <button class="btn btn-primary w-100" type="submit" <%= myBooks.length ? "" : "disabled" %>>Send exchange offer</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (!books.length) { %><div class="col-12"><div class="alert alert-light border text-center">No available books from other students right now.</div></div><% } %>
  </div>
</div>
