<% layout("layouts/boilerplate") %>

<div class="auth-page">
  <div class="auth-card auth-card-signup">
    <div class="auth-icon">
      <i class="bi bi-person-plus"></i>
    </div>

    <div class="text-center mb-4">
      <span class="auth-eyebrow">Join the community</span>
      <h1 class="auth-title">Create your BookLoop account</h1>
      <p class="auth-subtitle">Buy, sell and discover affordable books from students.</p>
    </div>

    <form action="/signup" method="POST" novalidate class="needs-validation auth-form">
      <div id="otpSection">
        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number</label>
          <div class="input-group auth-input-group auth-action-group">
            <span class="input-group-text"><i class="bi bi-phone"></i></span>
            <input type="tel" id="phone" name="phone" class="form-control" placeholder="+91XXXXXXXXXX" required value="" autocomplete="tel" inputmode="tel" />
            <button type="button" id="sendOTP" class="btn btn-outline-primary">Send OTP</button>
          </div>

          <div id="recaptcha-container" class="mt-3"></div>

          <div class="mb-3 mt-3">
            <label for="otp" class="form-label">OTP</label>
            <div class="input-group auth-input-group auth-action-group">
              <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
              <input type="text" id="otp" class="form-control" placeholder="Enter OTP" disabled />
              <button type="button" id="verifyOTP" class="btn btn-outline-success" disabled>Verify</button>
            </div>
          </div>

          <div id="otpStatus" class="auth-status" aria-live="polite"></div>
        </div>
      </div>

      <div id="signupSection" class="d-none">
        <div class="mb-3">
          <label for="accountType" class="form-label">Account type</label>
          <select id="accountType" name="accountType" class="form-select">
            <option value="student">Student / Individual seller</option>
            <option value="shop">Bookshop</option>
          </select>
        </div>
        <div id="studentAcademicFields" class="mb-3">
          <div class="border rounded-3 p-3">
            <div class="d-flex align-items-start gap-2 mb-3">
              <i class="bi bi-mortarboard text-primary fs-5"></i>
              <div>
                <h5 class="mb-1">Academic profile</h5>
                <p class="text-secondary small mb-0">BookLoop will use these details to automatically find books for your semester.</p>
              </div>
            </div>
            <div class="row g-2">
              <div class="col-md-6">
                <label for="signupDegree" class="form-label">Degree</label>
                <input id="signupDegree" name="degree" class="form-control" placeholder="e.g. BSc" required>
              </div>
              <div class="col-md-6">
                <label for="signupCourse" class="form-label">Course</label>
                <input id="signupCourse" name="course" class="form-control" placeholder="e.g. Computer Science" required>
              </div>
              <div class="col-md-6">
                <label for="signupAcademicYear" class="form-label">Academic Year</label>
                <input id="signupAcademicYear" name="academicYear" class="form-control" placeholder="e.g. 2026-27" required>
              </div>
              <div class="col-md-3">
                <label for="signupYear" class="form-label">Year</label>
                <select id="signupYear" name="year" class="form-select" required>
                  <option value="">Select</option>
                  <option value="1">First</option><option value="2">Second</option><option value="3">Third</option>
                  <option value="4">Fourth</option><option value="5">Fifth</option>
                </select>
              </div>
              <div class="col-md-3">
                <label for="signupSemester" class="form-label">Semester</label>
                <select id="signupSemester" name="semester" class="form-select" required>
                  <option value="">Select</option>
                  <% for(let n=1;n<=10;n++){ %><option value="<%= n %>"><%= n %></option><% } %>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div id="shopSignupFields" class="d-none">
          <div class="mb-3"><label for="shopName" class="form-label">Shop name</label><input id="shopName" name="shopName" class="form-control" maxlength="120" placeholder="Your bookstore name"></div>
          <div class="mb-3"><label for="shopAddress" class="form-label">Shop address</label><input id="shopAddress" name="shopAddress" class="form-control" maxlength="300" placeholder="Full shop address"></div>
          <div class="row g-2 mb-3">
            <div class="col"><label for="shopLatitude" class="form-label">Latitude</label><input id="shopLatitude" name="shopLatitude" type="number" step="any" class="form-control" placeholder="Latitude"></div>
            <div class="col"><label for="shopLongitude" class="form-label">Longitude</label><input id="shopLongitude" name="shopLongitude" type="number" step="any" class="form-control" placeholder="Longitude"></div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm mb-3" id="shopUseLocation">Use current shop location</button>
        </div>
        <div class="mb-3">
          <label for="signupUsername" class="form-label">Username</label>
          <div class="auth-input-group">
            <i class="bi bi-person"></i>
            <input id="signupUsername" name="username" class="form-control" placeholder="Choose a username" autocomplete="username" required />
          </div>
          <div class="invalid-feedback">Please enter a username.</div>
        </div>

        <div class="mb-3">
          <label for="signupEmail" class="form-label">Email</label>
          <div class="auth-input-group">
            <i class="bi bi-envelope"></i>
            <input id="signupEmail" type="email" name="email" class="form-control" placeholder="you@example.com" autocomplete="email" required />
          </div>
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <div class="auth-input-group">
            <i class="bi bi-lock"></i>
            <input id="password" type="password" name="password" class="form-control" placeholder="Create a password" autocomplete="new-password" required disabled />
            <button type="button" class="auth-password-toggle" data-password-target="password" aria-label="Show password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button id="createAccount" class="btn btn-primary w-100 auth-submit" type="submit" disabled>
          <i class="bi bi-person-check me-2"></i>
          Create Account
        </button>
      </div>
    </form>

    <div class="auth-divider"><span>Already have an account?</span></div>

    <a href="/login" class="btn btn-outline-primary w-100 auth-secondary-action">
      <i class="bi bi-box-arrow-in-right me-2"></i>
      Login Instead
    </a>
  </div>
</div>

<script>
  const firebaseConfig = <%- JSON.stringify(firebaseConfig || {}) %>;
  const accountType = document.getElementById("accountType");
  const shopFields = document.getElementById("shopSignupFields");
  const studentAcademicFields = document.getElementById("studentAcademicFields");
  const studentAcademicInputs = studentAcademicFields?.querySelectorAll("input, select") || [];

  function updateAccountTypeFields() {
    const isStudent = accountType?.value !== "shop";
    shopFields?.classList.toggle("d-none", isStudent);
    studentAcademicFields?.classList.toggle("d-none", !isStudent);
    studentAcademicInputs.forEach(input => {
      input.required = isStudent;
      input.disabled = !isStudent;
    });
  }

  accountType?.addEventListener("change", updateAccountTypeFields);
  updateAccountTypeFields();
  document.getElementById("shopUseLocation")?.addEventListener("click", () => {
    const status = document.getElementById("otpStatus");
    if (!navigator.geolocation) { status.textContent = "Location is not supported."; return; }
    status.textContent = "Getting shop location…";
    navigator.geolocation.getCurrentPosition(position => {
      document.getElementById("shopLatitude").value = position.coords.latitude;
      document.getElementById("shopLongitude").value = position.coords.longitude;
      status.textContent = "Shop location added.";
    }, () => { status.textContent = "Could not get location. Enter coordinates manually."; });
  });
  document.querySelectorAll('[data-password-target]').forEach((button) => {
    button.addEventListener('click', () => {
      const input = document.getElementById(button.dataset.passwordTarget);
      const icon = button.querySelector('i');
      if (!input || !icon) return;
      const visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      icon.className = visible ? 'bi bi-eye' : 'bi bi-eye-slash';
      button.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
    });
  });
</script>
