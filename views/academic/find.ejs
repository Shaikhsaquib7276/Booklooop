<% layout("/layouts/boilerplate") %>
<div class="academic-page">
 <section class="academic-hero"><span class="academic-eyebrow">BookLoop Academic Match</span><h1>Find the books you need for your semester.</h1><p>Choose your college, course, year and semester to see relevant books and second-hand listings.</p></section>
 <section class="academic-selector-card"><h2>Your academic details</h2><form action="/find-books" method="GET" id="academicFinderForm"><div class="row g-3">
 <% [["college","College","Select college",options.colleges],["course","Course","Select course",options.courses],["academicYear","Academic Year","Select year",options.academicYears],["semester","Semester","Select semester",options.semesters]].forEach((field,i)=>{ %>
 <div class="col-lg-3 col-md-6"><label class="form-label" for="academic-<%= field[0] %>"><%= field[1] %></label><select class="form-select" id="academic-<%= field[0] %>" name="<%= field[0] %>" required><option value=""><%= field[2] %></option><% field[3].forEach(value=>{ %><option value="<%= value %>" <%= String(filters[field[0]])===String(value)?"selected":"" %>><%= i===3?"Semester "+value:value %></option><% }) %></select></div>
 <% }) %></div><div class="academic-selector-actions"><button class="btn btn-primary btn-lg">Find My Books</button><a href="/find-books" class="btn btn-outline-secondary">Reset</a></div></form></section>
 <% if(complete){ %><div class="academic-results-heading mt-4"><div><h2>Your semester book map</h2><p><%= filters.college %> · <%= filters.course %> · <%= filters.academicYear %> · Semester <%= filters.semester %></p></div><a href="/book-requests" class="btn btn-outline-primary">My Requests</a></div>
 <% if(!subjects.length){ %><div class="academic-empty"><h3>No syllabus records found</h3><p>An administrator needs to add this college's academic catalog.</p></div><% } %>
 <% subjects.forEach(subject=>{ %><section class="academic-subject-card"><h3><%= subject.name %> <small><%= subject.code||"" %></small></h3><div class="row g-3"><% subject.books.forEach(item=>{ %><div class="col-lg-6"><article class="academic-book-card"><span class="badge text-bg-primary"><%= item.type %></span><h4><%= item.title %></h4><p><%= item.author||"Author not specified" %> <% if(item.edition){ %>· Edition <%= item.edition %><% } %></p>
 <% if(item.listings.length){ %><strong class="text-success"><%= item.listings.length %> available · from ₹<%= Math.min(...item.listings.map(x=>Number(x.price))).toFixed(0) %></strong><div class="d-flex flex-wrap gap-2 mt-2"><% item.listings.slice(0,4).forEach(listing=>{ %><a class="btn btn-sm btn-outline-primary" href="/books/<%= listing._id %>">View ₹<%= listing.price %></a><% }) %></div>
 <% }else{ %><p class="text-secondary">No second-hand copy listed right now.</p><% if(currentUser){ %><form method="POST" action="/book-requests/<%= item._id %>"><button class="btn btn-warning btn-sm">Request this book</button></form><% }else{ %><a href="/login" class="btn btn-outline-primary btn-sm">Login to request</a><% } %><% } %></article></div><% }) %></div></section><% }) %><% }else{ %><section class="academic-how-card"><h2>How it works</h2><p>Choose your academic details → see mapped books → view available copies or request a missing book.</p></section><% } %>
</div>
<script>
(()=>{const college=document.getElementById("academic-college"),course=document.getElementById("academic-course"),year=document.getElementById("academic-academicYear"),sem=document.getElementById("academic-semester");
const reset=(el,label)=>{el.replaceChildren(new Option(label,""));};
const load=async()=>{const params=new URLSearchParams();if(college.value)params.set("college",college.value);if(course.value)params.set("course",course.value);if(year.value)params.set("academicYear",year.value);const r=await fetch("/academic/options?"+params);if(!r.ok)return;const d=await r.json();const fill=(el,values,label)=>{const old=el.value;reset(el,label);values.forEach(v=>el.add(new Option(el===sem?"Semester "+v:v,v)));if(values.map(String).includes(old))el.value=old;};if(event?.target===college){fill(course,d.courses,"Select course");reset(year,"Select year");reset(sem,"Select semester");}else if(event?.target===course){fill(year,d.academicYears,"Select year");reset(sem,"Select semester");}else if(event?.target===year){fill(sem,d.semesters,"Select semester");}};
college.addEventListener("change",()=>{const event={target:college};loadWith(event);});course.addEventListener("change",()=>{const event={target:course};loadWith(event);});year.addEventListener("change",()=>{const event={target:year};loadWith(event);});
async function loadWith(e){const params=new URLSearchParams({college:college.value,course:course.value,academicYear:year.value});const r=await fetch("/academic/options?"+params);if(!r.ok)return;const d=await r.json();const fill=(el,vals,label)=>{el.replaceChildren(new Option(label,""));vals.forEach(v=>el.add(new Option(el===sem?"Semester "+v:v,v)));};if(e.target===college){fill(course,d.courses,"Select course");fill(year,[],"Select year");fill(sem,[],"Select semester");}if(e.target===course){fill(year,d.academicYears,"Select year");fill(sem,[],"Select semester");}if(e.target===year)fill(sem,d.semesters,"Select semester");}
})();
</script>