<% layout("/layouts/boilerplate") %>
<div class="academic-page">
  <section class="academic-hero">
    <span class="academic-eyebrow">BookLoop Smart Semester Finder</span>
    <h1>Find every book you need for your semester.</h1>
    <p>Your academic profile is used automatically. BookLoop checks verified academic mappings, then finds real second-hand listings and optionally narrows them to your nearby area.</p>
  </section>

  <% if(!complete){ %>
    <section class="academic-empty">
      <i class="bi bi-mortarboard"></i>
      <h3>Complete your academic profile</h3>
      <p>BookLoop needs your college, degree, course, academic year, year and semester before it can build your semester book list.</p>
      <a href="/profile/edit" class="btn btn-primary mt-2">Update Academic Profile</a>
    </section>
  <% } else { %>

    <section class="academic-profile-card">
      <div>
        <span class="academic-eyebrow">Current academic profile</span>
        <h2><%= profile.college %></h2>
        <p><%= profile.degree %> · <%= profile.course %> · <%= profile.academicYear %> · Year <%= profile.year %> · Semester <%= profile.semester %></p>
      </div>
      <a href="/profile/edit" class="btn btn-outline-primary btn-sm">Change Profile</a>
    </section>

    <section class="academic-location-bar mt-3">
      <div>
        <strong>Nearby mode</strong>
        <span class="small text-secondary d-block">Without a location, all verified marketplace matches are shown. Use your location to limit results by distance.</span>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <select class="form-select form-select-sm academic-radius" id="academicRadius" aria-label="Nearby search radius">
          <% [1,5,10,20,50].forEach(value=>{ %>
            <option value="<%= value %>" <%= radius===value?"selected":"" %>><%= value %> km</option>
          <% }) %>
        </select>
        <button type="button" class="btn btn-outline-primary btn-sm" id="useAcademicLocation">
          <i class="bi bi-crosshair me-1"></i><%= hasLocation ? "Update my location" : "Use my location" %>
        </button>
      </div>
    </section>

    <div class="academic-location-status mt-2" id="academicLocationStatus" aria-live="polite">
      <%= hasLocation ? "Nearby mode is active." : "All available matching listings are shown." %>
    </div>

    <form method="GET" action="/find-books" id="academicFinderForm">
      <input type="hidden" name="lat" id="academicLat" value="<%= searchLat %>">
      <input type="hidden" name="lng" id="academicLng" value="<%= searchLng %>">
      <input type="hidden" name="radius" id="academicRadiusHidden" value="<%= radius %>">
      <button type="submit" class="d-none">Refresh</button>
    </form>

    <section class="academic-progress-card mt-4">
      <div class="academic-results-heading">
        <div>
          <span class="academic-eyebrow">Semester inventory</span>
          <h2 class="h3 mb-1">Your required books</h2>
          <p class="mb-0"><%= summary.required %> catalog books · <%= summary.available %> currently matched · <%= summary.requested %> requested</p>
        </div>
        <a href="/book-requests" class="btn btn-outline-primary btn-sm">My Requests</a>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-6 col-lg-3"><div class="academic-stat-card"><span>Required</span><strong><%= summary.required %></strong><small>catalog books</small></div></div>
        <div class="col-6 col-lg-3"><div class="academic-stat-card"><span>Found</span><strong><%= summary.available %></strong><small>with listings</small></div></div>
        <div class="col-6 col-lg-3"><div class="academic-stat-card"><span>Requested</span><strong><%= summary.requested %></strong><small>waiting</small></div></div>
        <div class="col-6 col-lg-3"><div class="academic-stat-card"><span>Coverage</span><strong><%= summary.required ? Math.round(summary.available / summary.required * 100) : 0 %>%</strong><small>currently matched</small></div></div>
      </div>

      <div class="academic-progress-track mt-3" aria-label="Semester book availability progress">
        <span style="width:<%= summary.required ? Math.min(100, Math.round(summary.available / summary.required * 100)) : 0 %>%"></span>
      </div>
    </section>

    <% if(!subjects.length){ %>
      <div class="academic-empty mt-3">
        <i class="bi bi-journal-x"></i>
        <h3>No verified academic records found</h3>
        <p>There are no verified academic mappings for your exact college, degree, course, academic year, year and semester yet.</p>
      </div>
    <% } %>

    <% subjects.forEach(s=>{ %>
      <section class="academic-subject-card">
        <div class="academic-subject-heading">
          <div><span class="academic-subject-label">Subject</span><h3><%= s.name %></h3></div>
          <% if(s.code){ %><span class="badge text-bg-light"><%= s.code %></span><% } %>
        </div>

        <div class="row g-3">
          <% s.books.forEach(b=>{ %>
            <div class="col-lg-6">
              <article class="academic-book-card">
                <div class="d-flex align-items-start justify-content-between gap-2">
                  <span class="badge <%= b.type==="Prescribed"?"text-bg-primary":"text-bg-secondary" %>"><%= b.type %></span>
                  <% if(b.isbn){ %><span class="small text-secondary">ISBN <%= b.isbn %></span><% } %>
                </div>

                <h4><%= b.title %></h4>
                <p class="academic-book-meta mb-2"><%= b.author || "Author not specified" %><%= b.edition ? " · "+b.edition : "" %></p>

                <% if(b.listings.length){ %>
                  <div class="academic-availability-row">
                    <strong class="text-success"><i class="bi bi-check-circle me-1"></i>Book available</strong>
                    <span><%= b.listings.length %> listing<%= b.listings.length===1?"":"s" %> · from ₹<%= Math.min(...b.listings.map(x=>Number(x.price))).toFixed(0) %></span>
                  </div>

                  <div class="academic-listings">
                    <% b.listings.slice(0,4).forEach(x=>{ %>
                      <a class="academic-listing-chip" href="/books/<%= x._id %>">
                        <span>
                          <%= x.isOwnListing ? "Your Listing" : "₹"+Number(x.price).toLocaleString("en-IN") %>
                        </span>
                        <small>
                          <%= x.isOwnListing ? "View your book" : (x.condition || "Used") %><%= !x.isOwnListing && Number.isFinite(Number(x.distanceKm)) ? " · "+Number(x.distanceKm).toFixed(1)+" km" : "" %>
                        </small>
                      </a>
                    <% }) %>
                  </div>

                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <% if(b.listings.length===1){ %>
                      <a class="btn <%= b.listings[0].isOwnListing ? "btn-outline-primary" : "btn-success" %> btn-sm" href="/books/<%= b.listings[0]._id %>">
                        <i class="bi bi-eye me-1"></i><%= b.listings[0].isOwnListing ? "View Your Listing" : "View Book" %>
                      </a>
                    <% } else { %>
                      <% b.listings.slice(0,4).forEach(x=>{ %>
                        <a class="btn <%= x.isOwnListing ? "btn-outline-primary" : "btn-outline-success" %> btn-sm" href="/books/<%= x._id %>">
                          <i class="bi bi-eye me-1"></i><%= x.isOwnListing ? "Your Listing" : "View ₹"+Number(x.price).toLocaleString("en-IN") %>
                        </a>
                      <% }) %>
                    <% } %>
                  </div>
                <% } else if(b.requestStatus==="Open"){ %>
                  <div class="academic-unavailable">
                    <strong><i class="bi bi-bell me-1"></i>Request active</strong>
                    <span>We'll notify you when a matching listing is added.</span>
                  </div>
                  <a class="btn btn-outline-primary btn-sm mt-2" href="/book-requests">View request</a>
                <% } else if(b.requestStatus==="Matched" && b.matchedBookId){ %>
                  <div class="academic-availability-row">
                    <strong class="text-success"><i class="bi bi-check-circle me-1"></i>Book matched</strong>
                    <span>Your request has a seller match.</span>
                  </div>
                  <a class="btn btn-success btn-sm mt-2" href="/books/<%= b.matchedBookId %>">
                    <i class="bi bi-eye me-1"></i>View Book
                  </a>
                <% } else { %>
                  <div class="academic-unavailable">
                    <strong><i class="bi bi-hourglass-split me-1"></i>No second-hand copy available</strong>
                    <span>Request this academic book and we'll notify you when a matching seller lists it.</span>
                  </div>
                  <form method="POST" action="/book-requests/<%= b._id %>" class="mt-2">
                    <button class="btn btn-warning btn-sm"><i class="bi bi-bell me-1"></i>Request this book</button>
                  </form>
                <% } %>
              </article>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
  <% } %>
</div>

<script>
(() => {
  const locationButton = document.getElementById("useAcademicLocation");
  const status = document.getElementById("academicLocationStatus");
  const lat = document.getElementById("academicLat");
  const lng = document.getElementById("academicLng");
  const radius = document.getElementById("academicRadius");
  const hiddenRadius = document.getElementById("academicRadiusHidden");
  const form = document.getElementById("academicFinderForm");

  if (!locationButton || !status || !lat || !lng || !radius || !hiddenRadius || !form) return;

  radius.addEventListener("change", () => {
    hiddenRadius.value = radius.value;
    if (lat.value && lng.value) form.requestSubmit();
  });

  locationButton.addEventListener("click", () => {
    if (!navigator.geolocation) {
      status.textContent = "Your browser does not support location access.";
      status.classList.add("text-danger");
      return;
    }

    status.textContent = "Getting your location…";
    status.classList.remove("text-danger");

    navigator.geolocation.getCurrentPosition(
      position => {
        lat.value = position.coords.latitude.toFixed(6);
        lng.value = position.coords.longitude.toFixed(6);
        hiddenRadius.value = radius.value;
        status.textContent = "Location ready. Refreshing nearby results…";
        form.requestSubmit();
      },
      error => {
        console.error("Academic finder geolocation error:", error);
        status.textContent = error.code === 1
          ? "Location permission is blocked. Allow it in the browser and try again."
          : "Could not determine your location. Continue without nearby mode.";
        status.classList.add("text-danger");
      },
      { enableHighAccuracy:false, timeout:10000, maximumAge:300000 }
    );
  });
})();
</script>
