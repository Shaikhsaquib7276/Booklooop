<% layout("/layouts/boilerplate") %>
<div class="academic-page">
<section class="academic-hero"><span class="academic-eyebrow">BookLoop Academic Match</span><h1>Find the books you need for your semester.</h1><p>Choose your college, course, academic year and semester to discover prescribed books and second-hand copies.</p></section>
<section class="academic-selector-card"><h2 class="h4">Your academic details</h2><form method="GET" action="/find-books" id="academicFinderForm"><div class="row g-3">
<div class="col-md-6 col-lg-3"><label class="form-label">College</label><select class="form-select" id="academicCollege" name="college" required><option value="">Select college</option><% options.colleges.forEach(x=>{ %><option <%= filters.college===x?"selected":"" %>><%= x %></option><% }) %></select></div>
<div class="col-md-6 col-lg-3"><label class="form-label">Course</label><select class="form-select" id="academicCourse" name="course" required><option value="">Select course</option><% options.courses.forEach(x=>{ %><option <%= filters.course===x?"selected":"" %>><%= x %></option><% }) %></select></div>
<div class="col-md-6 col-lg-3"><label class="form-label">Academic Year</label><select class="form-select" id="academicYear" name="academicYear" required><option value="">Select year</option><% options.academicYears.forEach(x=>{ %><option <%= filters.academicYear===x?"selected":"" %>><%= x %></option><% }) %></select></div>
<div class="col-md-6 col-lg-3"><label class="form-label">Semester</label><select class="form-select" id="academicSemester" name="semester" required><option value="">Select semester</option><% options.semesters.forEach(x=>{ %><option value="<%= x %>" <%= Number(filters.semester)===x?"selected":"" %>>Semester <%= x %></option><% }) %></select></div></div><div class="academic-selector-actions"><button class="btn btn-primary btn-lg">Find My Books</button><a href="/find-books" class="btn btn-outline-secondary">Reset</a></div></form></section>
<% if(complete){ %><div class="academic-results-heading mt-4"><div><h2 class="h3">Your semester book map</h2><p><%= filters.college %> · <%= filters.course %> · <%= filters.academicYear %> · Semester <%= filters.semester %></p></div><a class="btn btn-outline-primary" href="/book-requests">My Requests</a></div>
<% if(!subjects.length){ %><div class="academic-empty"><h3>No syllabus records found</h3><p>An admin needs to add this course's book list.</p></div><% } %>
<% subjects.forEach(s=>{ %><section class="academic-subject-card"><h3><%= s.name %> <small><%= s.code||"" %></small></h3><div class="row g-3"><% s.books.forEach(b=>{ %><div class="col-lg-6"><article class="academic-book-card"><span class="badge text-bg-primary"><%= b.type %></span><h4><%= b.title %></h4><p><%= b.author||"Author not specified" %> <%= b.edition?"· "+b.edition:"" %></p>
<% if(b.listings.length){ %><strong class="text-success"><%= b.listings.length %> available · from ₹<%= Math.min(...b.listings.map(x=>Number(x.price))).toFixed(0) %></strong><div class="d-flex flex-wrap gap-2 mt-2"><% b.listings.slice(0,4).forEach(x=>{ %><a class="btn btn-sm btn-outline-primary" href="/books/<%= x._id %>">View ₹<%= x.price %></a><% }) %></div><% }else{ %><p class="text-secondary">No second-hand copy listed right now.</p><% if(currentUser){ %><form method="POST" action="/book-requests/<%= b._id %>"><button class="btn btn-warning btn-sm">Request this book</button></form><% }else{ %><a href="/login" class="btn btn-outline-primary btn-sm">Login to request</a><% } %><% } %></article></div><% }) %></div></section><% }) %>
<% }else{ %><section class="academic-how-card"><h2 class="h4">How it works</h2><p>Select your academics → find mapped books → request missing copies → get notified when listed.</p></section><% } %></div>
<script>(()=>{const c=document.getElementById("academicCollege"),co=document.getElementById("academicCourse"),y=document.getElementById("academicYear"),s=document.getElementById("academicSemester");const fill=(el,vals,label)=>{el.replaceChildren(new Option(label,""));vals.forEach(v=>el.add(new Option(el===s?"Semester "+v:v,v)));};async function load(params){const u=new URL("/academic/options",location.origin);Object.entries(params).forEach(([k,v])=>v&&u.searchParams.set(k,v));const r=await fetch(u);if(!r.ok)throw Error("Options unavailable");return r.json();}c.addEventListener("change",async()=>{try{const d=await load({college:c.value});fill(co,d.courses,"Select course");fill(y,[],"Select year");fill(s,[],"Select semester");}catch(e){console.error(e)}});co.addEventListener("change",async()=>{try{const d=await load({college:c.value,course:co.value});fill(y,d.academicYears,"Select year");fill(s,[],"Select semester");}catch(e){console.error(e)}});y.addEventListener("change",async()=>{try{const d=await load({college:c.value,course:co.value,academicYear:y.value});fill(s,d.semesters,"Select semester");}catch(e){console.error(e)}})})();</script>