<% layout("/layouts/boilerplate") %><div class="academic-page"><div class="academic-results-heading"><div><h1>My Book Requests</h1><p>Track books you need for your semester.</p></div><a href="/find-books" class="btn btn-primary">Find Books</a></div><% if(!requests.length){ %><div class="academic-empty"><h3>No requests yet</h3><p>Request unavailable books from your semester book map.</p></div><% }else{ %><div class="academic-request-list"><% requests.forEach(r=>{ %><article class="academic-request-card"><div><span class="badge <%= r.status==="Matched"?"text-bg-success":"text-bg-secondary" %>"><%= r.status %></span><h3><%= r.academicBook?r.academicBook.title:"Book removed" %></h3><p><%= r.college %> · <%= r.course %> · <%= r.academicYear %> · Sem <%= r.semester %></p></div><% if(r.matchedBook){ %><a class="btn btn-success btn-sm" href="/books/<%= r.matchedBook._id %>">View matching book</a><% }else{ %><small>Waiting for a seller.</small><% } %></article><% }) %></div><% } %></div>
