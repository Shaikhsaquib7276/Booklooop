<% layout("/layouts/boilerplate") %><div class="academic-page"><div class="academic-results-heading"><div><h1>My Academic Books</h1><p>Relist books you bought after you finish using them.</p></div><a href="/find-books" class="btn btn-outline-primary">Find Books</a></div><% if(!books.length){ %><div class="academic-empty"><h3>Your academic library is empty</h3><p>Academic purchases will appear here after checkout.</p></div><% }else{ %><div class="academic-request-list"><% books.forEach(b=>{ %><article class="academic-request-card"><div><span class="badge text-bg-success"><%= b.status %></span><h3><%= b.titleSnapshot %></h3><p>Purchased <%= new Date(b.purchasedAt).toLocaleDateString() %> · ₹<%= b.pricePaid %></p></div><% if(b.status==="Owned"&&b.book){ %><form method="POST" action="/my-academic-books/<%= b._id %>/relist"><button class="btn btn-primary btn-sm">Sell this book to juniors</button></form><% }else if(b.relistedBook){ %><a href="/books/<%= b.relistedBook %>" class="btn btn-outline-primary btn-sm">View relisting</a><% } %></article><% }) %></div><% } %></div>