<% layout("/layouts/boilerplate") %><div class="academic-page"><div class="academic-results-heading"><div><h1>My Academic Books</h1><p>Books you purchased through BookLoop and can relist after using them.</p></div><a href="/find-books" class="btn btn-outline-primary">Find Books</a></div>
<% if(!books.length){ %><div class="academic-empty"><h3>Your academic library is empty</h3><p>Eligible purchases will appear here when checkout is linked to academic books.</p></div><% }else{ %><div class="academic-request-list"><% books.forEach(item=>{ %><article class="academic-request-card"><div><span class="badge <%= item.status==="Owned"?"text-bg-success":"text-bg-secondary" %>"><%= item.status %></span><h3><%= item.titleSnapshot %></h3><p>Purchased <%= new Date(item.purchasedAt).toLocaleDateString() %> · ₹<%= item.pricePaid %></p></div><div><% if(item.status==="Owned"&&item.book){ %><form method="POST" action="/my-academic-books/<%= item._id %>/relist" onsubmit="return confirm('Create a new listing using the previous details? You can review it before sharing.')"><button class="btn btn-primary btn-sm">Sell this book to juniors</button></form><% }else if(item.relistedBook){ %><a href="/books/<%= item.relistedBook %>" class="btn btn-outline-primary btn-sm">View relisting</a><% } %></div></article><% }) %></div><% } %></div>