<% layout("layouts/boilerplate") %>

<div class="container py-4 py-md-5 user-page">
    <div class="user-page-header">
        <div>
            <span class="user-eyebrow">Your activity</span>
            <h1>My Reservation Requests</h1>
            <p>Track the books you asked sellers to reserve.</p>
        </div>
        <a href="/books" class="btn btn-primary"><i class="bi bi-search me-2"></i>Browse Books</a>
    </div>

    <% if (reservations.length === 0) { %>
        <div class="user-empty">
            <div class="user-empty-icon"><i class="bi bi-calendar-check"></i></div>
            <h3>No reservations yet</h3>
            <p>When you request a book, you can follow its reservation status from here.</p>
            <a href="/books" class="btn btn-primary"><i class="bi bi-search me-2"></i>Browse Books</a>
        </div>
    <% } else { %>
        <div class="row g-3 g-md-4">
            <% reservations.forEach((reservation) => { %>
                <div class="col-md-6 col-lg-4">
                    <article class="reservation-card">
                        <% if (reservation.book) { %>
                            <div class="user-book-image"><img src="<%= reservation.book.image.url %>" alt="<%= reservation.book.title %>"></div>
                        <% } else { %>
                            <div class="user-book-image d-grid place-items-center"><div class="user-empty-icon mb-0"><i class="bi bi-book"></i></div></div>
                        <% } %>
                        <div class="user-book-body">
                            <span class="reservation-status <%= reservation.status.toLowerCase() %>">
                                <i class="bi <%= reservation.status === 'Accepted' ? 'bi-check-circle' : reservation.status === 'Pending' ? 'bi-clock' : 'bi-info-circle' %>"></i>
                                <%= reservation.status %>
                            </span>
                            <h5 class="mt-3"><%= reservation.book ? reservation.book.title : 'Deleted listing' %></h5>
                            <p class="user-book-seller mb-0"><i class="bi bi-person me-1"></i>Seller: <strong><%= reservation.seller ? reservation.seller.username : 'Unavailable' %></strong></p>
                        </div>
                        <div class="user-book-footer">
                            <% if (reservation.book) { %>
                                <a href="/books/<%= reservation.book._id %>" class="btn btn-outline-primary w-100"><i class="bi bi-eye me-1"></i>View Book</a>
                            <% } else { %>
                                <span class="text-secondary small">Listing unavailable</span>
                            <% } %>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>