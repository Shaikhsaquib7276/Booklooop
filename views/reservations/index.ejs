<% layout("layouts/boilerplate") %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Reservation Requests</h1>
            <p class="text-secondary mb-0">Track the books you asked sellers to reserve.</p>
        </div>
        <a href="/books" class="btn btn-primary">Browse Books</a>
    </div>

    <% if (reservations.length === 0) { %>
        <div class="alert alert-info">You have not requested any books yet.</div>
    <% } else { %>
        <div class="row g-4">
            <% reservations.forEach((reservation) => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <% if (reservation.book) { %>
                            <img src="<%= reservation.book.image.url %>" class="card-img-top" style="height: 220px; object-fit: cover;" alt="<%= reservation.book.title %>">
                        <% } %>
                        <div class="card-body">
                            <span class="badge <%= reservation.status === 'Accepted' ? 'bg-success' : reservation.status === 'Pending' ? 'bg-warning text-dark' : 'bg-secondary' %> mb-2"><%= reservation.status %></span>
                            <h5 class="fw-bold"><%= reservation.book ? reservation.book.title : 'Deleted listing' %></h5>
                            <p class="text-secondary mb-2">Seller: <%= reservation.seller ? reservation.seller.username : 'Unavailable' %></p>
                            <% if (reservation.book) { %>
                                <a href="/books/<%= reservation.book._id %>" class="btn btn-outline-primary">View Book</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>
