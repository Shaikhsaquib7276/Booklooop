<% layout("layouts/boilerplate") %>

    <div class="container py-5">

        <!-- Welcome -->

        <div class="dashboard-header mb-5">

            <h1 class="fw-bold">

                👋 Welcome, <%= currentUser.username %>

            </h1>

            <p class="text-secondary">

                Manage your books and marketplace activity.

            </p>

        </div>

        <!-- Stats -->

        <div class="row g-4 mb-5">

            <div class="col-lg-3 col-md-6">

                <div class="dashboard-card">

                    <i class="bi bi-book display-5 text-primary"></i>

                    <h2>
                        <%= availableBooks %>
                    </h2>

                    <p>Total Books</p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="dashboard-card">

                    <i class="bi bi-currency-rupee display-5 text-success"></i>

                    <h2>₹<%= totalValue %>
                    </h2>

                    <p>Total Value</p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="dashboard-card">

                    <i class="bi bi-check-circle display-5 text-info"></i>

                    <h2>
                        <%= totalBooks %>
                    </h2>

                    <p>Available</p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="dashboard-card">

                    <i class="bi bi-heart-fill display-5 text-danger"></i>

                    <h2><%= wishlistCount %></h2>

                    <p>Wishlist</p>

                </div>

            </div>

        </div>

        <!-- Quick Actions -->

        <div class="d-flex flex-wrap gap-3 mb-5">

            <a href="/books/new" class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>

                Add Book

            </a>

            <a href="/books" class="btn btn-outline-primary">

                <i class="bi bi-search"></i>

                Browse Books

            </a>

            <a href="/dashboard" class="btn btn-outline-success">

                <i class="bi bi-speedometer2"></i>

                Refresh

            </a>

        </div>

        <!-- My Books -->

        <h2 class="fw-bold mb-4">

            My Books

        </h2>

        <% if(books.length===0){ %>

            <div class="alert alert-info">

                You haven't listed any books yet.

            </div>

            <% } else { %>

                <div class="row">

                    <% books.forEach(book=>{ %>

                        <div class="col-lg-4 col-md-6 mb-4">

                            <div class="card h-100 shadow-sm">

                                <img src="<%= book.image.url %>" class="card-img-top"
                                    style="height:250px;object-fit:cover;">

                                <div class="card-body">

                                    <h5 class="fw-bold">

                                        <%= book.title %>

                                    </h5>

                                    <p class="text-secondary">

                                        <%= book.author %>

                                    </p>

                                    <h4 class="text-primary">

                                        ₹<%= book.price %>

                                    </h4>

                                </div>

                                <div class="d-flex justify-content-start">

                                    <a href="/books/<%= book._id %>" class="btn btn-outline-primary btn-sm">

                                        View

                                    </a>

                                    <a href="/books/<%= book._id %>/edit" class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                    <form action="/books/<%= book._id %>?_method=DELETE" method="POST">

                                        <button class="btn btn-danger btn-sm">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

                <% } %>

        <hr class="my-5">

        <h2 class="fw-bold mb-4">Pending Reservation Requests</h2>

        <% if (pendingReservations.length === 0) { %>
            <div class="alert alert-light border">There are no pending reservation requests for your listings.</div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Buyer</th>
                            <th>Requested</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pendingReservations.forEach((reservation) => { %>
                            <tr>
                                <td><%= reservation.book ? reservation.book.title : "Deleted listing" %></td>
                                <td><%= reservation.buyer ? reservation.buyer.username : "Deleted user" %></td>
                                <td><%= new Date(reservation.createdAt).toLocaleDateString() %></td>
                                <td class="text-end">
                                    <form action="/reservations/<%= reservation._id %>/accept" method="POST" class="d-inline">
                                        <button class="btn btn-success btn-sm">Accept</button>
                                    </form>
                                    <form action="/reservations/<%= reservation._id %>/reject" method="POST" class="d-inline">
                                        <button class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

    </div>
