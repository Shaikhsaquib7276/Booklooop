<% layout("layouts/boilerplate") %>

<div class="container py-4 py-md-5 dashboard-page">

    <div class="dashboard-header mb-4 mb-md-5">
        <div>
            <span class="dashboard-eyebrow">Your marketplace</span>
            <h1 class="fw-bold mb-2">👋 Welcome, <%= currentUser.username %></h1>
            <p class="mb-0">Manage your books and marketplace activity from one place.</p>
        </div>
        <div class="dashboard-header-icon"><i class="bi bi-speedometer2"></i></div>
    </div>

    <div class="row g-3 g-lg-4 mb-4 mb-md-5">
        <div class="col-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-stat-icon text-primary"><i class="bi bi-book"></i></div>
                <h2><%= availableBooks %></h2>
                <p>Total Books</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-stat-icon text-success"><i class="bi bi-currency-rupee"></i></div>
                <h2>₹<%= totalValue %></h2>
                <p>Total Value</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-stat-icon text-info"><i class="bi bi-check-circle"></i></div>
                <h2><%= totalBooks %></h2>
                <p>Available</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-stat-icon text-danger"><i class="bi bi-heart-fill"></i></div>
                <h2><%= wishlistCount %></h2>
                <p>Wishlist</p>
            </div>
        </div>
    </div>

    <div class="dashboard-section dashboard-actions-section mb-5">
        <div class="dashboard-section-heading">
            <div>
                <span class="dashboard-eyebrow">Shortcuts</span>
                <h2>Quick Actions</h2>
            </div>
        </div>
        <div class="dashboard-actions">
            <a href="/books/new" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Add Book</a>
            <a href="/books" class="btn btn-outline-primary"><i class="bi bi-search me-2"></i>Browse Books</a>
            <a href="/dashboard" class="btn btn-outline-success"><i class="bi bi-arrow-clockwise me-2"></i>Refresh</a>
        </div>
    </div>

    <div class="dashboard-section mb-5">
        <div class="dashboard-section-heading">
            <div>
                <span class="dashboard-eyebrow">Your listings</span>
                <h2>My Books</h2>
            </div>
            <span class="dashboard-count"><%= books.length %> <%= books.length === 1 ? 'book' : 'books' %></span>
        </div>

        <% if(books.length===0){ %>
            <div class="dashboard-empty">
                <div class="dashboard-empty-icon"><i class="bi bi-book"></i></div>
                <h4>No books listed yet</h4>
                <p>Start selling your unused books and reach other students.</p>
                <a href="/books/new" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>List Your First Book</a>
            </div>
        <% } else { %>
            <div class="row g-3 g-md-4">
                <% books.forEach(book=>{ %>
                    <div class="col-lg-4 col-md-6">
                        <article class="dashboard-book-card h-100">
                            <div class="dashboard-book-image">
                                <img src="<%= book.image.url %>" alt="<%= book.title %>">
                            </div>
                            <div class="dashboard-book-body">
                                <h5><%= book.title %></h5>
                                <p class="dashboard-book-author"><%= book.author %></p>
                                <div class="dashboard-book-meta">
                                    <strong>₹<%= book.price %></strong>
                                    <span class="badge <%= book.status === 'Available' ? 'bg-success' : book.status === 'Reserved' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= book.status %></span>
                                </div>
                            </div>
                            <div class="dashboard-book-actions">
                                <a href="/books/<%= book._id %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-eye me-1"></i>View</a>
                                <a href="/books/<%= book._id %>/edit" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
                                <form action="/books/<%= book._id %>?_method=DELETE" method="POST">
                                    <button class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Delete</button>
                                </form>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <div class="dashboard-section">
        <div class="dashboard-section-heading">
            <div>
                <span class="dashboard-eyebrow">Buyer activity</span>
                <h2>Pending Reservation Requests</h2>
            </div>
            <span class="dashboard-count"><%= pendingReservations.length %> pending</span>
        </div>

        <% if (pendingReservations.length === 0) { %>
            <div class="dashboard-empty dashboard-empty-compact">
                <div class="dashboard-empty-icon"><i class="bi bi-inbox"></i></div>
                <h5>No pending requests</h5>
                <p>Reservation requests for your listings will appear here.</p>
            </div>
        <% } else { %>
            <div class="dashboard-table-wrap">
                <div class="table-responsive">
                    <table class="table dashboard-table align-middle mb-0">
                        <thead><tr><th>Book</th><th>Buyer</th><th>Requested</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                            <% pendingReservations.forEach((reservation) => { %>
                                <tr>
                                    <td data-label="Book"><%= reservation.book ? reservation.book.title : "Deleted listing" %></td>
                                    <td data-label="Buyer"><%= reservation.buyer ? reservation.buyer.username : "Deleted user" %></td>
                                    <td data-label="Requested"><%= new Date(reservation.createdAt).toLocaleDateString() %></td>
                                    <td data-label="Actions" class="text-md-end">
                                        <div class="dashboard-request-actions">
                                            <form action="/reservations/<%= reservation._id %>/accept" method="POST" class="d-inline"><button class="btn btn-success btn-sm">Accept</button></form>
                                            <form action="/reservations/<%= reservation._id %>/reject" method="POST" class="d-inline"><button class="btn btn-outline-danger btn-sm">Reject</button></form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>
</div>
